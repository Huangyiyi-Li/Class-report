{
  "name": "classroom-recorder-electron",
  "version": "0.2.0-codex.19",
  "private": true,
  "description": "课堂录音采集助手 Windows 客户端",
  "author": "XXT",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "electron": "npm run build && electron .",
    "electron:smoke": "npm run build && ELECTRON_SMOKE_TEST=1 electron .",
    "electron:dev": "node scripts/start-dev.mjs",
    "electron:dev:app": "electron .",
    "electron:install": "node scripts/install-electron.mjs",
    "build": "vite build",
    "pack:win": "npm run build && electron-builder --win dir --x64 --publish never",
    "dist:win": "node scripts/build-windows-release.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/*.test.js && npm run test:repository",
    "test:repository": "node scripts/test-clean-checkout.mjs",
    "build:worker": "python scripts/build-worker.py",
    "prepare": "cd .. && husky electron-recorder/.husky"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "dependencies": {
    "@audio/encode-opus": "^1.0.2",
    "electron-updater": "^6.8.9",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "lucide-react": "^0.545.0",
    "prettier": "^3.9.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.9"
  },
  "build": {
    "appId": "cn.xxt.classroom-recorder",
    "productName": "课堂录音采集助手",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**",
      "src/main.js",
      "src/worker-client.js",
      "src/single-instance.js",
      "src/worker-bootstrap.js",
      "src/api-routes.js",
      "src/worker-settings.js",
      "src/runtime-state.js",
      "src/settings.js",
      "src/settings-save.js",
      "src/update-manager.js",
      "src/backend.js",
      "src/binding-service.js",
      "src/binding-controller.js",
      "src/passport-login.js",
      "src/floating-drag.js",
      "src/diagnostics.js",
      "src/ipc-result.cjs",
      "src/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.ico",
          "icon.png"
        ]
      },
      {
        "from": "build/worker/ClassroomRecorderWorker.exe",
        "to": "worker/ClassroomRecorderWorker.exe"
      },
      {
        "from": "build/ffmpeg/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      }
    ],
    "asar": true,
    "compression": "normal",
    "publish": [
      {
        "provider": "github",
        "owner": "Huangyiyi-Li",
        "repo": "Class-report",
        "releaseType": "prerelease",
        "channel": "codex"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "warningsAsErrors": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "课堂录音采集助手",
      "deleteAppDataOnUninstall": false,
      "artifactName": "classroom-recorder-electron-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "classroom-recorder-electron-portable-${version}.${ext}"
    }
  }
}
